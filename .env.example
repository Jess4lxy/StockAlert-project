# Copiar este archivo como .env y ajustar los valores. No subir .env a GitHub.

# PostgreSQL (local con Docker)
POSTGRES_DB=stockalert
POSTGRES_USER=stockalert
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stockalert:cambia_esta_contrasena@localhost:5432/stockalert

# Backend
API_PORT=3000

# Frontend (Vite)
VITE_API_URL=http://localhost:3000/api
