# Copiar este archivo como .env y llenar las contraseñas. No subir .env a GitHub.
# Generar cada contraseña con (una distinta para cada usuario):
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# PostgreSQL (local con Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockalert

# Dueño de la base: lo usa el ETL para crear tablas, cargar datos e índices
POSTGRES_USER=stockalert
POSTGRES_PASSWORD=

# Usuario de solo lectura de la API (lo crea npm run roles en etl/)
API_DB_USER=stockalert_api
API_DB_PASSWORD=

# Backend
API_PORT=3000

# Frontend (Vite)
VITE_API_URL=http://localhost:3000/api

# Sesiones: firma de los tokens JWT de la API (mínimo 32 caracteres, aleatoria)
JWT_SECRET=

# Administradores de la plataforma (npm run plataforma en etl/): crean empresas y usuarios.
# Contraseñas de al menos 12 caracteres.
ADMIN1_NOMBRE="Administrador Uno"
ADMIN1_CORREO=admin1@stockalert.test
ADMIN1_CONTRASENA=
ADMIN2_NOMBRE="Administrador Dos"
ADMIN2_CORREO=admin2@stockalert.test
ADMIN2_CONTRASENA=

# n8n (opcional): URL de producción del webhook que recibe las alertas nuevas y token
# compartido. La API lo envía en X-StockAlert-Token y n8n lo usa en el mismo encabezado
# para registrar solicitudes de reposición (POST /api/integraciones/n8n/solicitudes).
# Generarlo igual que las contraseñas.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Prueba de rendimiento (npm run bench en etl/): un usuario de la empresa demo
BENCH_CORREO=
BENCH_CONTRASENA=
